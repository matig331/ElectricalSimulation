# Compiled NEURON mechanisms (platform-specific; rebuild with nrnivmodl on any machine)
x86_64/
arm64/
*.o
special

# Python
__pycache__/
*.pyc

# Job run outputs -- these are DATA from a specific run, not code
parts_*/
results_*/
merged_*/
stats_*/
logs/
culture_P*.csv
culture_Pmap*.pdf
culture_phase_maps.pdf
culture_Vm_traces.*
dryrun_P*.csv
phase_diagram.pdf
single_neuron_check.*
recruitment_Pactivation.csv
*.log
*.o[0-9]*
*.e[0-9]*

# Temp per-worker slice files (created and deleted during a run; stray leftovers
# from a killed job could otherwise get committed by accident)
_cw*.asc
_ce_*.asc
_ps_*.asc
_snc_*.asc
_rec.asc

# Morphology reconstruction data (large, binary-ish, lab data -- not source code;
# consider Git LFS or a separate data store if you DO want this version-controlled)
eyal_archive/
bundle_extracted/

# Backups left by the MobaXterm in-place patch script
*.bak

# Local Python environments and macOS archive debris
.venv/
.DS_Store
__MACOSX/
analysis/
interim/
