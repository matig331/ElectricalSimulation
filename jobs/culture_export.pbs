#!/bin/bash
# ---------------------------------------------------------------------------
# PBS/Torque -- FULL RUN: the activation-probability deliverable.
# Run jobs/dryrun.pbs FIRST and set the walltime below from the number it prints.
# Submit:  qsub jobs/culture_export.pbs
# ---------------------------------------------------------------------------
#PBS -N culture_export
#PBS -l nodes=1:ppn=1
# <-- EDIT from the dry run's estimate
#PBS -l walltime=24:00:00
# <-- EDIT: your queue name
#PBS -q batch
#PBS -j oe
#PBS -o culture_export.log

set -euo pipefail

# Locate the repo robustly. A scheduler copies the script to a spool directory, so
# the script's own path is unreliable; and qsub may have been run from either the
# repo root OR from jobs/. Try each candidate and pick the one that actually
# contains the code. Quoted throughout: the real path contains a space.
REPO=""
for cand in "${PBS_O_WORKDIR:-}" "${PBS_O_WORKDIR:-}/.." "$PWD" "$PWD/.." "$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)" "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"; do
    if [ -n "$cand" ] && [ -f "$cand/culture_export.py" ]; then
        REPO="$(cd "$cand" && pwd)"
        break
    fi
done
if [ -z "$REPO" ]; then
    echo "FATAL: could not locate the repo (culture_export.py not found)." >&2
    echo "       Tried PBS_O_WORKDIR='${PBS_O_WORKDIR:-unset}' and the script directory." >&2
    exit 1
fi
cd "$REPO"

source jobs/env_setup.sh

# Parameters come from config.py (n_cultures, network_half_um, use_hpc_count,
# density_per_mm2, culture_distance_mode). Echo them so the log records exactly
# what this run used -- the log is the provenance record for the thesis.
python -c "
from config import CFG
n = CFG.n_neurons_effective()
print('n_cultures       :', CFG.n_cultures)
print('neurons/culture  :', n)
print('layers           :', CFG.layers_um)
print('distance_mode    :', CFG.culture_distance_mode)
print('i0_uA            :', CFG.i0_uA)
print('total sims       :', CFG.n_cultures * n * len(CFG.layers_um))
"

# SERIAL = ONE core. Refuse a production-size run here: at ~10 s/sim a full culture
# campaign would need months. Production runs use jobs/submit_seeded.sh (parallel).
NSIMS=$(python -c "from config import CFG; print(CFG.n_cultures * CFG.n_neurons_effective() * len(CFG.layers_um))")
if [ "$NSIMS" -gt "${MAX_SERIAL_SIMS:-2000}" ] && [ "${ALLOW_SERIAL:-0}" != "1" ]; then
    echo "FATAL: serial run of $NSIMS simulations on ONE core. Use jobs/submit_seeded.sh," \
         "or set ALLOW_SERIAL=1 if you really mean it." >&2
    exit 1
fi

SECONDS=0
python culture_export.py
echo "---------------------------------------------------------------"
echo "elapsed: ${SECONDS} s"
wc -l culture_Pactivation.csv culture_Pdepolarization.csv culture_Phyperpolarization.csv
echo "finished: $(date)"

# Expected on success, in $REPO: culture_Pactivation.csv, culture_Pdepolarization.csv,
# culture_Phyperpolarization.csv and culture_Pmap_<outcome>.pdf (config.cell_model).
